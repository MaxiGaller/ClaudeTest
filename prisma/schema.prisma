// Prisma schema for the Family Activity Recommender MVP.
// Provider: PostgreSQL (PostGIS / radius search can be added later).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonType {
  adult
  child
}

enum PetType {
  dog
  cat
  other
}

enum FeedbackType {
  fits
  not_fitting
  more_like_this
  never_again
}

enum EnergyLevel {
  quiet
  normal
  action
}

// Diskriminator für den vereinten Feed: dauerhafte Attraktion vs. zeitbegrenztes Event.
enum FeedItemType {
  attraction
  event
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  familyProfiles FamilyProfile[]
  reviews        Review[]
}

model FamilyProfile {
  id               String   @id @default(cuid())
  userId           String
  name             String
  homeLocationName String?
  homeLatitude     Float?
  homeLongitude    Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  persons            Person[]
  pets               Pet[]
  mobilityPreset     MobilityPreset?
  budgetPreset       BudgetPreset?
  reviews            Review[]
  recommendationRuns RecommendationRun[]
}

model Person {
  id              String     @id @default(cuid())
  familyProfileId String
  name            String
  type            PersonType
  birthDate       DateTime?
  notes           String?

  familyProfile FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
}

model Pet {
  id              String  @id @default(cuid())
  familyProfileId String
  name            String
  type            PetType
  mustJoinDefault Boolean @default(false)
  notes           String?

  familyProfile FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
}

model MobilityPreset {
  id                String  @id @default(cuid())
  familyProfileId   String  @unique
  hasCar            Boolean @default(true)
  publicTransportOk Boolean @default(true)
  bikeOk            Boolean @default(false)
  strollerRequired  Boolean @default(false)
  maxTravelMinutes  Int     @default(45)
  notes             String?

  familyProfile FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
}

model BudgetPreset {
  id              String  @id @default(cuid())
  familyProfileId String  @unique
  maxCostTotal    Int? // null = "egal"
  preferFree      Boolean @default(false)
  notes           String?

  familyProfile FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
}

// Dauerhaftes Ausflugsziel (evergreen): Orte, die unabhängig vom Datum gelten
// (Zoo, Spielplatz, Wanderung, Badesee …).
model Attraction {
  id                       String  @id @default(cuid())
  name                     String
  description              String
  category                 String
  region                   String  @default("muenchen") // Region-Slug, siehe lib/regions.ts
  address                  String?
  latitude                 Float?
  longitude                Float?
  estimatedCost            Int     @default(0) // EUR total for the family, rough estimate
  estimatedDurationMinutes Int     @default(120)
  minChildAgeMonths        Int     @default(0)
  maxChildAgeMonths        Int     @default(216) // up to ~18y
  dogFriendly              Boolean @default(false)
  strollerFriendly         Boolean @default(false)
  rainSafe                 Boolean @default(false)
  indoor                   Boolean @default(false)
  outdoor                  Boolean @default(false)
  foodAvailable            Boolean @default(false)
  openingHoursText         String?
  websiteUrl               String?
  ticketUrl                String? // rohe Ticketshop-URL; Affiliate-Tracking wird zur Laufzeit ergänzt
  source                   String? // origin / reliability note for the data

  // Ausflugs-/Wanderbezug (optional, z. B. aus OSM-Quellen).
  difficulty String? // easy | moderate | hard
  lengthKm   Float?

  // Ingestion provenance / dedupe
  sourceName String? // adapter id, e.g. "overpass-hiking", "attraction-fixture", "seed"
  sourceUrl  String?
  externalId String? // stable id from the source for idempotent upserts
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceName, externalId])
  @@index([region])
}

// Zeitbegrenztes Event: gilt nur an bestimmten Tagen (Zirkus, Flohmarkt, Fest …).
// Läuft nach validUntil ab und wird vom Ingestion-Job geprunt.
model Event {
  id                       String  @id @default(cuid())
  name                     String
  description              String
  category                 String
  region                   String  @default("muenchen")
  address                  String?
  latitude                 Float?
  longitude                Float?
  estimatedCost            Int     @default(0)
  estimatedDurationMinutes Int     @default(120)
  minChildAgeMonths        Int     @default(0)
  maxChildAgeMonths        Int     @default(216)
  dogFriendly              Boolean @default(false)
  strollerFriendly         Boolean @default(false)
  rainSafe                 Boolean @default(false)
  indoor                   Boolean @default(false)
  outdoor                  Boolean @default(false)
  foodAvailable            Boolean @default(false)
  websiteUrl               String?
  ticketUrl                String? // rohe Ticketshop-URL; Affiliate-Tracking wird zur Laufzeit ergänzt
  source                   String?

  // Zeitfenster des Events.
  startsAt   DateTime?
  endsAt     DateTime?
  validUntil DateTime? // record verschwindet nach diesem Zeitpunkt; null = unbestimmt

  // Ingestion provenance / dedupe
  sourceName String?
  sourceUrl  String?
  externalId String?
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceName, externalId])
  @@index([region])
  @@index([validUntil])
}

// Polymorpher Tag: gehört entweder zu einer Attraktion oder einem Event.
// Bewusst ohne harte FK (itemType + itemId), damit der Feed vereint bleibt.
model ItemTag {
  id       String       @id @default(cuid())
  itemType FeedItemType
  itemId   String
  tag      String

  @@unique([itemType, itemId, tag])
  @@index([tag])
  @@index([itemType, itemId])
}

// Nutzerbewertung – polymorph auf Attraktion oder Event.
model Review {
  id              String       @id @default(cuid())
  userId          String
  familyProfileId String
  itemType        FeedItemType
  itemId          String
  rating          Int? // optional 1-5
  feedbackType    FeedbackType
  comment         String?
  createdAt       DateTime     @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyProfile FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)

  @@index([familyProfileId, itemType, itemId])
}

model RecommendationRun {
  id                String      @id @default(cuid())
  familyProfileId   String
  region            String      @default("muenchen")
  requestedDate     DateTime    @default(now())
  timeBudgetMinutes Int
  maxBudget         Int?
  maxTravelMinutes  Int
  dogMustJoin       Boolean     @default(false)
  strollerRequired  Boolean     @default(false)
  energyLevel       EnergyLevel @default(normal)
  weatherCondition  String? // rain | sun | cold | hot | null
  createdAt         DateTime    @default(now())

  familyProfile FamilyProfile          @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  results       RecommendationResult[]
}

// Ein einzelnes Ergebnis – verweist polymorph auf Attraktion oder Event.
model RecommendationResult {
  id                  String       @id @default(cuid())
  recommendationRunId String
  itemType            FeedItemType
  itemId              String
  score               Int
  explanation         String
  warnings            String? // JSON-encoded string[] for portability

  recommendationRun RecommendationRun @relation(fields: [recommendationRunId], references: [id], onDelete: Cascade)

  @@index([itemType, itemId])
}

// Audit record for each daily ingestion run (observability of the central job).
model IngestRun {
  id                String    @id @default(cuid())
  region            String    @default("muenchen")
  source            String // which source(s) were ingested
  status            String    @default("running") // running | done | failed
  enrichedBy        String? // "ai" | "rule-based"
  eventsCreated     Int       @default(0)
  eventsUpdated     Int       @default(0)
  eventsPruned      Int       @default(0)
  attractionsCreated Int      @default(0)
  attractionsUpdated Int      @default(0)
  notes             String?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
}
