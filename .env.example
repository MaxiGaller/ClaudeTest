# PostgreSQL connection string used by Prisma.
# Matches the docker-compose service below.
DATABASE_URL="postgresql://family:family@localhost:5432/family_recommender?schema=public"

# --- Täglicher Ingestion-Job (optional) ---
# Der Job ist region-agnostisch und läuft über alle aktiven Regionen
# (siehe lib/regions.ts; aktuell nur "muenchen"). Optional auf eine Region begrenzen:
INGEST_REGION=""
# URL des echten Veranstaltungs-Feeds (bitte verifizieren) – Quelle "muenchen-open-data".
EVENT_FEED_URL=""
# Overpass-API-Endpoint für dauerhafte Ausflugsziele aus OSM (Quelle "overpass-hiking").
# Ohne diese URL wird die Overpass-Quelle übersprungen (Fixture greift weiterhin).
OVERPASS_API_URL=""

# --- KI-Anreicherung (optional) ---
# Wenn gesetzt, reichert der Tagesjob Items per Claude an (sonst regelbasiert).
ANTHROPIC_API_KEY=""
# Aktuelles Claude-Modell eintragen (z. B. das neueste Opus-Modell).
ANTHROPIC_MODEL=""

# --- Affiliate-/Ticket-Links (optional) ---
# Partner-IDs der Ticket-Netzwerke. Nur gesetzte IDs erzeugen Affiliate-Tracking;
# ohne ID wird die rohe Ticket-URL ohne Provision verlinkt. Tracking-Parameter
# je Programm bitte gegen die Partnerbedingungen verifizieren.
AFFILIATE_GETYOURGUIDE_ID=""
AFFILIATE_TIQETS_ID=""
AFFILIATE_EVENTIM_ID=""
AFFILIATE_REGIONDO_ID=""
